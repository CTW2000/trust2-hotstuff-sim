.DS_Store

.db*
db_*
*.json
*.log

benchmark/client
benchmark/node

# Generated by Cargo
# will have compiled files and executables
**/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# Tracked despite *.json: upstream benchmark settings, the T_tru, G1 and G2 test vectors, the link-delay tables.
!benchmark/settings.json
!consensus/src/tests/ttru_vectors.json
!consensus/src/tests/g2_vectors.json
!consensus/src/tests/g1_vectors.json
!benchmark/nets/*.json
